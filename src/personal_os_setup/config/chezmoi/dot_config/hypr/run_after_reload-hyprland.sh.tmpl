{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu

# runs after every sync that touches hypr/: clears Lua's package.loaded

script_name="run_after_reload-hyprland.sh.tmpl"
notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$1" "[$script_name] $2"; }

command -v hyprctl >/dev/null 2>&1 || exit 0
hyprctl monitors >/dev/null 2>&1 || exit 0

# require() caches modules, so a plain reload keeps stale content -- clear them first.
modules=(variables colors environment decorations animations misc xwayland autostart inputs binds hyprbars windowrules monitors workspaces noctalia)
for m in "${modules[@]}"; do
  hyprctl eval "package.loaded[\"$m\"] = nil" >/dev/null 2>&1 || true
done

hyprctl reload >/dev/null 2>&1 || true
notify "Hyprland config" "Reloaded after dotfiles sync"
{{ end -}}
