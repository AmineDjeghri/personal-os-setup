{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu

script_name="run_onchange_after_enable-greeter-passwordless-sync.sh.tmpl"
notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$1" "[$script_name] $2"; }

# Lets `[shell.greeter_sync] auto_sync` push wallpaper/palette/font to the login screen without a polkit password
# prompt. Installs a root-owned polkit rule (/etc/polkit-1/rules.d), scoped to the greeter's constrained sync action
# only -- hence this run_onchange script instead of a plain chezmoi dotfile. Needs noctalia-greeter >= 1.5.0.
user="{{ .chezmoi.username }}"

if ! command -v noctalia-greeter >/dev/null 2>&1; then
  echo "WARNING: noctalia-greeter not installed, skipping passwordless greeter sync setup" >&2
  notify "Greeter sync" "noctalia-greeter not installed, skipped"
  exit 0
fi

# Needs a live sudo ticket (even just to read the rules directory for `status`) -- can't prompt here (no TTY).
if ! sudo -n true 2>/dev/null; then
  echo "WARNING: sudo needs a fresh password prompt -- re-run personal-os-setup and enter your password when it starts, then sync this again." >&2
  notify "Greeter sync" "Needs sudo -- re-run personal-os-setup and try again"
  exit 1
fi

# Prints "<user>: not enabled by the noctalia-greeter managed rule" when the rule is missing.
status="$(sudo noctalia-greeter passwordless-sync status "$user" 2>/dev/null || true)"
if printf '%s\n' "$status" | grep -q -- "^$user:" && ! printf '%s\n' "$status" | grep -qi "not enabled"; then
  exit 0
fi

echo "Enabling passwordless Noctalia greeter sync for $user..."
sudo noctalia-greeter passwordless-sync enable "$user"
notify "Greeter sync" "Passwordless appearance sync enabled for $user"
{{ end -}}
