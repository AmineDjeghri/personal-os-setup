{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu

script_name="run_after_fix-nct6687-dkms.sh.tmpl"
notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$1" "[$script_name] $2"; }

# NCT6687D-R fan/temp Super-I/O chip (MSI B550M MORTAR and others): coolercontrold
# only sees GPU fans without this module. Package is nct6687d-dkms-git (paru/AUR).
if ! command -v pacman >/dev/null 2>&1 || ! command -v dkms >/dev/null 2>&1; then
  exit 0
fi

if ! pacman -Qq nct6687d-dkms-git >/dev/null 2>&1; then
  exit 0
fi

# Already built for the running kernel -- nothing to do.
if modinfo nct6687 >/dev/null 2>&1; then
  exit 0
fi

pkgver=$(pacman -Q nct6687d-dkms-git | awk '{print $2}' | sed 's/-[0-9]*$//')
kver="$(uname -r)"

# Needs a live sudo ticket -- can't prompt here (no TTY), so fail fast instead of hanging.
if ! sudo -n true 2>/dev/null; then
  echo "WARNING: sudo needs a fresh password prompt -- re-run personal-os-setup and enter your password when it starts, then sync this again." >&2
  notify "nct6687 dkms" "Needs sudo -- re-run personal-os-setup and try again"
  exit 1
fi

echo "Building nct6687 DKMS module for kernel ${kver}..."
if sudo dkms install "nct6687d-dkms-git/${pkgver}" -k "$kver" --force; then
  sudo modprobe nct6687
  if systemctl is-active --quiet coolercontrold 2>/dev/null; then
    sudo systemctl restart coolercontrold
  fi
  notify "nct6687 dkms" "Module built and loaded for ${kver}"
else
  echo "WARNING: dkms install failed for nct6687 on kernel ${kver} -- check /var/lib/dkms/nct6687d-dkms-git/${pkgver}/build/make.log" >&2
  notify "nct6687 dkms" "Build failed -- check make.log"
fi
{{ end -}}
