::=p2p[\"[Torrent P2P: ⚠️]\"||\"\"]}\n{stream.type::=http[\"[Web Link: 💻]\"||\"\"]}\n{stream.type::=live[\"[Live: 📺]\"||\"\"]}\n{stream.type::=Debrid[\"🍁|Debrid \"||\"\"]}\n{stream.type::=Usenet[\"♻️|Usenet \"||\"\"]}\n{service.cached::istrue[\"⚡️]\"||\"\"]}{service.cached::isfalse[\"⏳]\"||\"\"]}\n{stream.type::~p2p[\"🔗 P2P 🌱 {stream.seeders}\"||\"\"]}",
          "description": "{stream.visualTags::exists::isfalse[\"📺 𝑁/𝐴 \"||\"\"]}{stream.visualTags::exists[\"📺 {stream.visualTags::join(' · ')} \"||\"\"]}\n{stream.audioTags::exists::isfalse[\"🔊 𝑁/𝐴 \"||\"\"]}{stream.audioTags::exists[\"🔊 {stream.audioTags::join(' · ')}\"||\"\"]}{stream.audioChannels::exists[\" · {stream.audioChannels::join(' · ')::replace('2.0', '2.0 Stereo')}\"||\"· 𝑁/𝐴\"]}\n{stream.size::exists::isfalse[\"📁 𝑁/𝐴 \"||\"\"]}{stream.size::>0[\"📁 {stream.size::bytes} \"||\"\"]}{stream.folderSize::>0[\"📦 {stream.folderSize::bytes}\"||\"\"]}{stream.age::exists[\"📅 {stream.age} \"||\"\"]}\n{stream.languages::exists::isfalse[\"🌎 𝑁/𝐴 \"||\"\"]}{stream.languages::exists[\"🌎 {stream.languages::join(', ')::replace('Multi, ', 'Multi · ')::replace('Dual Audio, ', 'Dual Audio · ')}\"||\"\"]}\n{stream.filename::~nf[\"🍿 Netflix \"||\"\"]}{stream.filename::~dsnp[\"🏰 Disney+ \"||\"\"]}{stream.filename::~hmax[\"🎭 HBO Max \"||\"\"]}{stream.filename::~amzn[\"🚚 Amazon \"||\"\"]}{stream.filename::~prme[\"🚚 Prime Video \"||\"\"]}{stream.filename::~aptv[\"🍏 Apple TV+ \"||\"\"]}{stream.filename::~hulu[\"📽️ Hulu \"||\"\"]}{stream.filename::~pmtp[\"🏔️ Paramount+ \"||\"\"]}{stream.filename::~pckk[\"🦚 Peacock \"||\"\"]}{stream.filename::~crtc[\"🍊 Crunchyroll \"||\"\"]}{stream.filename::~anpx[\"🎌 Anime Plex \"||\"\"]}{stream.filename::~stz[\"⭐ Starz \"||\"\"]}{stream.filename::~dscv[\"🌎 Discovery+ \"||\"\"]}{stream.filename::~glob[\"🌐 Globoplay \"||\"\"]}{stream.filename::~mubi[\"🎬 Mubi \"||\"\"]}{stream.filename::~tlcn[\"🎦 Telecine \"||\"\"]}{stream.filename::~look[\"👁️ Looke \"||\"\"]}{stream.filename::~cltv[\"📡 Claro TV+ \"||\"\"]}{stream.filename::~mcrp[\"🛍️ Mercado Play \"||\"\"]}{stream.filename::~itun[\"💿 iTunes \"||\"\"]}{stream.filename::~stan[\"🇦🇺 Stan \"||\"\"]}{stream.filename::~hotstar[\"🌟 Hotstar \"||\"\"]}{stream.filename::~videoland[\"🇳🇱 Videoland \"||\"\"]}{stream.filename::~brvc[\"📽️ Bravia Core \"||\"\"]}{stream.filename::~tver[\"📡 TVer \"||\"\"]}{stream.filen